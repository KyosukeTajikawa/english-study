{
  "name": "english-study-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "typecheck:functions": "tsc --noEmit -p functions/tsconfig.json",
    "preview": "npm run build && wrangler pages dev out/ --compatibility-date=2026-09-07",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "npm --prefix lambda run db:reset-test && playwright test"
  },
  "dependencies": {
    "aws4fetch": "1.0.20",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "31.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.11",
    "wrangler": "^4.129.1"
  }
}
