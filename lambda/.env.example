# Lambda 側の環境変数（ローカル開発用）
#
# このファイルはコミットする。実際の値は lambda/.env に書く（.gitignore 済み）。
# 本番は AWS Secrets Manager / SSM Parameter Store に置き、
# template.yaml からは動的参照で読む。リテラル値を template.yaml に書かないこと。

# Pages Functions ↔ Lambda 間の共有シークレット。
# 生成: openssl rand -hex 32
# .dev.vars 側の INTERNAL_API_KEY と同じ値にすること。
INTERNAL_API_KEY=

# --- 以下はステップ3以降で追加する ---

# Neon の pooled 接続文字列（...-pooler.<region>.aws.neon.tech）
# DATABASE_URL=

# Prisma のマイグレーション用（unpooled = 直結）。
# PgBouncer 経由だとマイグレーションが失敗するため別に持つ。
# DIRECT_URL=

# E2E 用（Neon のブランチ）
# DATABASE_URL_TEST=

# Cloudflare Access
# CF_ACCESS_TEAM_DOMAIN=
# CF_ACCESS_AUD=
# ローカルのテスト用 JWKS に差し替える場合のみ設定する。
# 本番では index.ts が Cloudflare のドメインであることを無条件に検証する。
# CF_ACCESS_JWKS_URL=

# Gemini API
# GEMINI_API_KEY=

# Web Push
# VAPID_PRIVATE_KEY=
