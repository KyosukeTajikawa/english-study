# Lambda 側の環境変数（ローカル開発・Prisma CLI 用）
#
# このファイルはコミットする。実際の値は lambda/.env に書く（.gitignore 済み）。
# 本番の秘密情報は SSM Parameter Store（SecureString）に置き、Lambda には
# 「パラメータ名」だけを渡す（src/lib/secrets.ts 参照）。値を template.yaml に書かないこと。

# Pages Functions ↔ Lambda 間の共有シークレット。
# 生成: openssl rand -hex 32
# .dev.vars 側の INTERNAL_API_KEY と同じ値にすること。
INTERNAL_API_KEY=

# --- データベース（Neon）---

# pooled 接続文字列（ホスト名に -pooler が付く）。Lambda・シードが使う。
# 本番は SSM の /english-study-app/database-url に同じ値を SecureString で登録する。
DATABASE_URL=

# unpooled（直結）の接続文字列。prisma migrate だけが使う。
# PgBouncer 経由だとマイグレーションが失敗しうるため別に持つ。
DIRECT_URL=

# E2E 用（Neon のブランチ。ステップ4で使う）
# DATABASE_URL_TEST=

# シードで作るユーザー。自分のログイン用メールにすると、画面からシードの単語が見える。
# 未設定なら seed@example.com
# SEED_USER_EMAIL=

# --- Cloudflare Access ---
# 本番の値は samconfig.toml の parameter_overrides に固定してある。

# CF_ACCESS_TEAM_DOMAIN=
# CF_ACCESS_AUD=
# ローカルのテスト用 JWKS に差し替える場合のみ設定する（ステップ4）。
# 本番では index.ts が Cloudflare のドメインであることを無条件に検証する。
# CF_ACCESS_JWKS_URL=

# --- ステップ6以降で追加する ---

# Gemini API
# GEMINI_API_KEY=

# Web Push
# VAPID_PRIVATE_KEY=
